        <geom name="gap_strip_6" type="box" size="0.85 2.5 0.0250" pos="10 0 -0.0250" material="groundplane" friction="1.0 0.005 0.0"/>
        <geom name="gap_strip_7" type="box" size="0.85 2.5 0.0250" pos="12 0 -0.0250" material="groundplane" friction="1.0 0.005 0.0"/>
        <geom name="gap_strip_8" type="box" size="0.85 2.5 0.0250" pos="14 0 -0.0250" material="groundplane" friction="1.0 0.005 0.0"/>
