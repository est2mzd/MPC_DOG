    <geom name="up_05" type="box" size="0.1300 1.5000 0.5000" pos="4.1700 0 0.4000" rgba="0.72 0.62 0.48 1" friction="1.5 0.1 0.05" solref="0.007 1" solimp="0.95 0.99 0.002"/>
    <geom name="top_run" type="box" size="0.5000 1.5000 0.5900" pos="4.8000 0 0.4900" rgba="0.86 0.84 0.70 1" friction="1.5 0.1 0.05" solref="0.007 1" solimp="0.95 0.99 0.002"/>
    <geom name="down_01" type="box" size="0.1300 1.5000 0.5000" pos="5.4300 0 0.4000" rgba="0.62 0.58 0.70 1" friction="1.5 0.1 0.05" solref="0.007 1" solimp="0.95 0.99 0.002"/>
    <geom name="down_02" type="box" size="0.1300 1.5000 0.4100" pos="5.6900 0 0.3100" rgba="0.50 0.46 0.60 1" friction="1.5 0.1 0.05" solref="0.007 1" solimp="0.95 0.99 0.002"/>
