    <geom name="down_04" type="box" size="0.1300 1.5000 0.2300" pos="6.2100 0 0.1300" rgba="0.50 0.46 0.60 1" friction="1.5 0.1 0.05" solref="0.007 1" solimp="0.95 0.99 0.002"/>
    <geom name="down_05" type="box" size="0.1300 1.5000 0.1400" pos="6.4700 0 0.0400" rgba="0.62 0.58 0.70 1" friction="1.5 0.1 0.05" solref="0.007 1" solimp="0.95 0.99 0.002"/>
