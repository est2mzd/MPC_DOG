    <geom name="top_run" type="box" size="0.1750 1.5000 0.5500" pos="6.3250 0 0.4500" rgba="0.86 0.84 0.70 1" friction="1.5 0.1 0.05" solref="0.007 1" solimp="0.95 0.99 0.002"/>
    <geom name="down_01" type="box" size="0.1750 1.5000 0.5000" pos="6.6750 0 0.4000" rgba="0.62 0.58 0.70 1" friction="1.5 0.1 0.05" solref="0.007 1" solimp="0.95 0.99 0.002"/>
