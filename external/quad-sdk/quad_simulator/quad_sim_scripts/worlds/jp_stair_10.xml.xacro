<?xml version="1.0" encoding="utf-8"?>
<mujoco model="jp_stair_10" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Japanese house stair.
       riser 0.18 m, tread 0.24 m, 2R+T = 0.60 m.
       first riser x=3.00 (spawn x=0 is 3 m before it), landing x=[5.40, 7.40]
       z=1.80, exit floor from x=9.56, stop x=11.56.
       Terrain MAP is models/jp_stair_10/meshes/jp_stair_10.ply. -->
  <xacro:arg name="meshdir" default=""/>
  <xacro:arg name="mjcf_path" default=""/>
  <compiler angle="radian" meshdir="$(arg meshdir)" texturedir="$(arg meshdir)" autolimits="true"/>
  <include file="$(arg mjcf_path)"/>
  <worldbody>
    <light directional="true" diffuse=".8 .8 .8" specular=".2 .2 .2" pos="0 0 8" dir="0 0 -1"/>
    <geom name="approach" type="box" size="2.0000 1.5000 0.0500" pos="1.0000 0 -0.0500" rgba="0.75 0.82 0.75 1" friction="1.5 0.1 0.05" solref="0.007 1" solimp="0.95 0.99 0.002"/>
